// Prisma schema for AgriCredit AI backend
// Datasource and generator configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum LenderType {
  COMMERCIAL_BANK
  MICROFINANCE
  SACCO
  DEVELOPMENT_BANK
}

enum Role {
  LOAN_OFFICER
  BNR_MONITOR
  ADMIN
}

enum LoanCaseStatus {
  DRAFT
  DOCUMENTS_COMPLETE
  SCORED
  DECIDED
}

enum DocType {
  LOAN_RECORDS
  REPAYMENT_HISTORY
  COOPERATIVE_PROFILE
  OFFTAKE_AGREEMENT
  ATTACHMENT
}

enum ImportStatus {
  PENDING
  VALIDATED
  CONFIRMED
  REJECTED
}

enum ScoreBand {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  INSUFFICIENT_DATA
}

enum DecisionType {
  APPROVE
  REJECT
  OVERRIDE_APPROVE
  OVERRIDE_REJECT
}

enum TransactionType {
  CREDIT
  DEBIT
}

// ==========================================
// Models
// ==========================================

model Lender {
  id        String     @id @default(uuid())
  name      String
  type      LenderType @default(COMMERCIAL_BANK)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users     User[]
  loanCases LoanCase[]

  @@map("lenders")
}

model User {
  id           String   @id @default(uuid())
  lenderId     String?  @map("lender_id")
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(LOAN_OFFICER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lender            Lender?    @relation(fields: [lenderId], references: [id], onDelete: SetNull)
  createdCases      LoanCase[] @relation("CaseCreator")
  uploadedDocuments Document[] @relation("DocumentUploader")
  decisions         Decision[]

  @@index([lenderId])
  @@map("users")
}

model Cooperative {
  id                String   @id @default(uuid())
  name              String
  registrationNo    String   @unique @map("registration_no")
  tin               String   @unique @map("tin")
  district          String   @default("Gasabo")
  sector            String
  yearFounded       Int      @map("year_founded")
  memberCount       Int      @map("member_count")
  totalHectares     Float    @map("total_hectares")
  storageCapacityT  Float    @map("storage_capacity_t")
  womenLed          Boolean  @default(false) @map("women_led")
  hasDigitalHistory Boolean  @default(false) @map("has_digital_history")
  recordQuality     Int      @default(100) @map("record_quality")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  consents            Consent[]
  loanCases           LoanCase[]
  loanRecords         LoanRecord[]
  repaymentHistory    RepaymentHistory[]
  accountTransactions AccountTransaction[]

  @@index([tin])
  @@index([name])
  @@index([district])
  @@index([sector])
  @@map("cooperatives")
}

model Consent {
  id             String    @id @default(uuid())
  cooperativeId  String    @map("cooperative_id")
  loanCaseId     String?   @map("loan_case_id")
  purpose        String
  granted        Boolean   @default(false)
  signatoryName  String    @map("signatory_name")
  grantedAt      DateTime? @map("granted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  loanCase    LoanCase?   @relation(fields: [loanCaseId], references: [id], onDelete: Cascade)

  @@index([cooperativeId])
  @@index([loanCaseId])
  @@map("consents")
}

model LoanCase {
  id                 String         @id @default(uuid())
  cooperativeId      String         @map("cooperative_id")
  lenderId           String?        @map("lender_id")
  createdById        String         @map("created_by")
  requestedAmountRwf BigInt         @map("requested_amount_rwf")
  tenorMonths        Int            @map("tenor_months")
  purpose            String
  status             LoanCaseStatus @default(DRAFT)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  cooperative        Cooperative        @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  lender             Lender?            @relation(fields: [lenderId], references: [id], onDelete: SetNull)
  createdBy          User               @relation("CaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  consents           Consent[]
  documents          Document[]
  loanRecords        LoanRecord[]
  repaymentHistory   RepaymentHistory[]
  offtakeAgreements  OfftakeAgreement[]
  scores             Score[]
  decision           Decision?

  @@index([cooperativeId])
  @@index([lenderId])
  @@index([createdById])
  @@index([status])
  @@map("loan_cases")
}

model Document {
  id           String       @id @default(uuid())
  loanCaseId   String       @map("loan_case_id")
  docType      DocType      @map("doc_type")
  filename     String
  storagePath  String       @map("storage_path")
  importStatus ImportStatus @default(PENDING) @map("import_status")
  rowCount     Int          @default(0) @map("row_count")
  errorCount   Int          @default(0) @map("error_count")
  uploadedById String       @map("uploaded_by")
  extractedData Json?       @map("extracted_data")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  loanCase   LoanCase @relation(fields: [loanCaseId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([loanCaseId])
  @@index([uploadedById])
  @@map("documents")
}

model LoanRecord {
  id              String    @id @default(uuid())
  cooperativeId   String?   @map("cooperative_id")
  loanCaseId      String?   @map("loan_case_id")
  institutionName String    @map("lender_name")
  accountNo       String?   @map("account_no")
  facilityType    String    @default("WORKING_CAPITAL") @map("facility_type")
  amountRwf       BigInt    @map("amount_rwf")
  tenorMonths     Int       @map("tenor_months")
  disbursedOn     DateTime  @map("disbursed_on")
  closedOn        DateTime? @map("closed_on")
  status          String
  isHistorical    Boolean   @default(true) @map("is_historical")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  cooperative Cooperative?       @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  loanCase    LoanCase?          @relation(fields: [loanCaseId], references: [id], onDelete: Cascade)
  repayments  RepaymentHistory[]

  @@index([cooperativeId])
  @@index([loanCaseId])
  @@map("loan_records")
}

model RepaymentHistory {
  id            String    @id @default(uuid())
  cooperativeId String?   @map("cooperative_id")
  loanCaseId    String?   @map("loan_case_id")
  loanRecordId  String?   @map("loan_record_id")
  installmentNo Int?      @map("installment_no")
  dueDate       DateTime  @map("due_date")
  paidDate      DateTime? @map("paid_date")
  amountDueRwf  BigInt    @map("amount_due_rwf")
  amountPaidRwf BigInt    @map("amount_paid_rwf")
  daysPastDue   Int       @default(0) @map("days_past_due")
  penaltyRwf    BigInt    @default(0) @map("penalty_rwf")
  isHistorical  Boolean   @default(true) @map("is_historical")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  cooperative Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  loanCase    LoanCase?    @relation(fields: [loanCaseId], references: [id], onDelete: Cascade)
  loanRecord  LoanRecord?  @relation(fields: [loanRecordId], references: [id], onDelete: SetNull)

  @@index([cooperativeId])
  @@index([loanCaseId])
  @@index([loanRecordId])
  @@map("repayment_history")
}

model AccountTransaction {
  id              String          @id @default(uuid())
  cooperativeId   String          @map("cooperative_id")
  institutionName String          @map("institution_name")
  accountNo       String          @map("account_no")
  transactionDate DateTime        @map("transaction_date")
  transactionType TransactionType @map("transaction_type")
  category        String
  amountRwf       BigInt          @map("amount_rwf")
  balanceAfterRwf BigInt          @map("balance_after_rwf")
  reference       String?
  description     String
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  @@index([cooperativeId, transactionDate])
  @@index([transactionType])
  @@index([category])
  @@map("account_transactions")
}

model OfftakeAgreement {
  id               String   @id @default(uuid())
  loanCaseId       String   @map("loan_case_id")
  buyerName        String   @map("buyer_name")
  volumeKg         Float    @map("volume_kg")
  agreedPriceRwfKg Float    @map("agreed_price_rwf_kg")
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")
  isVerified       Boolean  @default(false) @map("is_verified")
  isHistorical     Boolean  @default(false) @map("is_historical")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  loanCase LoanCase @relation(fields: [loanCaseId], references: [id], onDelete: Cascade)

  @@index([loanCaseId])
  @@map("offtake_agreements")
}

model ModelVersion {
  id           String    @id @default(uuid())
  name         String
  algorithm    String
  trainedAt    DateTime? @map("trained_at")
  auc          Float?
  metrics      Json?
  artifactPath String?   @map("artifact_path")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  scores Score[]

  @@map("model_versions")
}

model Score {
  id                String    @id @default(uuid())
  loanCaseId        String    @map("loan_case_id")
  modelVersionId    String?   @map("model_version_id")
  inputSnapshot     Json      @map("input_snapshot")
  defaultProb       Float     @map("default_prob")
  band              ScoreBand
  scorePoints       Float     @map("score_points")
  suggestedLimitRwf BigInt    @map("suggested_limit_rwf")
  uncertaintyFlag   Boolean   @default(false) @map("uncertainty_flag")
  isWhatIf          Boolean   @default(false) @map("is_what_if")
  createdAt         DateTime  @default(now()) @map("created_at")

  loanCase     LoanCase      @relation(fields: [loanCaseId], references: [id], onDelete: Cascade)
  modelVersion ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)
  reasons      ScoreReason[]
  decisions    Decision[]

  @@index([loanCaseId, createdAt])
  @@index([modelVersionId])
  @@map("scores")
}

model ScoreReason {
  id             String   @id @default(uuid())
  scoreId        String   @map("score_id")
  rank           Int
  feature        String
  impactPoints   Float    @map("impact_points")
  shapValue      Float?   @map("shap_value")
  statement      String
  sourceType     String   @map("source_type")
  recordIds      String[] @map("record_ids")
  documentSource String?  @map("document_source")
  messageEn      String   @map("message_en")
  createdAt      DateTime @default(now()) @map("created_at")

  score Score @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([scoreId])
  @@map("score_reasons")
}

model Decision {
  id                String       @id @default(uuid())
  loanCaseId        String       @unique @map("loan_case_id")
  scoreId           String       @map("score_id")
  decidedById       String       @map("decided_by")
  decision          DecisionType
  approvedAmountRwf BigInt       @map("approved_amount_rwf")
  reason            String?
  recommendations   String?
  decidedAt         DateTime     @default(now()) @map("decided_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  loanCase  LoanCase @relation(fields: [loanCaseId], references: [id], onDelete: Restrict)
  score     Score    @relation(fields: [scoreId], references: [id], onDelete: Restrict)
  decidedBy User     @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([scoreId])
  @@index([decidedById])
  @@map("decisions")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}
